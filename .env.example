# Secrets only — copy to .env and fill in.
# Lists of services/containers live in config.yaml (see config.example.yaml).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides (otherwise taken from config.yaml):
# CONFIG_FILE=./config.yaml
# REPORT_INTERVAL=24h
# CHECK_INTERVAL=60s
# REPORT_STYLE=full
# CPU_ALERT=85
# RAM_ALERT=90
# DISK_ALERT=90
# LOAD_ALERT=2.0
# WATCH_SERVICES=docker,ssh
# WATCH_CONTAINERS=nginx,postgres
# RESTART_SCRIPT=
# RESTART_COMMAND=restart
# STATE_FILE=/var/lib/hostpulse/state.json
# DISK_PATH=/
# HOSTNAME=
# ALERT_COOLDOWN=15m
# NET_IFACE=auto
